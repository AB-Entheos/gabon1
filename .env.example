# HEC Emergency Fund — environment variables
# Copy to .env and fill in. Do NOT commit .env.

# Django
SECRET_KEY=change-me-in-prod
DJANGO_SETTINGS_MODULE=hec_fund.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (prod uses Postgres; dev uses SQLite automatically)
DB_NAME=hec
DB_USER=hec
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker + DRF cache + throttle)
REDIS_URL=redis://localhost:6379/0

# S3 / object storage (django-storages)
S3_ENDPOINT_URL=
S3_BUCKET=hec-attachments
S3_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (outbound email) — Microsoft 365
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@ab-entheos.co.ke
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=hec@ab-entheos.com

# CORS — comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Fund settings
MEDICAL_CEILING_XAF=2000000
BURIAL_CEILING_XAF=3000000
FIRST_AID_PCT=20

# Approval HMAC (must be set in prod)
APPROVAL_HMAC_SECRET=change-me-in-prod

# Mobile money (Phase 11 — placeholder values)
MOOV_MONEY_API_URL=https://api.moov-money.example/v1
MOOV_MONEY_API_KEY=
AIRTEL_MONEY_API_URL=https://api.airtel-money.example/v1
AIRTEL_MONEY_API_KEY=

# Telegram (Phase 8 — placeholder values)
TELEGRAM_BOT_TOKEN=
